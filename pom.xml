<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>43.0.0</version>
    <relativePath />
  </parent>

  <groupId>io.github.jiyuuchc</groupId>
  <artifactId>biopb-fiji-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>biopb-fiji-plugin</name>
  <description>Fiji/ImageJ2 plugin: browse and open tensors served by a biopb tensor server</description>
  <url>https://github.com/biopb/biopb-fiji-plugin</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>biopb</name>
    <url>https://github.com/biopb</url>
  </organization>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>jiyuuchc</id>
      <name>Ji Yu</name>
      <roles><role>founder</role><role>lead</role><role>developer</role></roles>
    </developer>
  </developers>

  <contributors>
    <contributor><name>None</name></contributor>
  </contributors>
  <mailingLists>
    <mailingList>
      <name>Image.sc Forum</name>
      <archive>https://forum.image.sc/</archive>
    </mailingList>
  </mailingLists>
  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/biopb/biopb-fiji-plugin/actions</url>
  </ciManagement>

  <scm>
    <connection>scm:git:https://github.com/biopb/biopb-fiji-plugin</connection>
    <developerConnection>scm:git:git@github.com:biopb/biopb-fiji-plugin</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/biopb/biopb-fiji-plugin</url>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/biopb/biopb-fiji-plugin/issues</url>
  </issueManagement>

  <properties>
    <package-name>io.github.jiyuuchc.biopb.fiji</package-name>
    <license.licenseName>mit</license.licenseName>
    <license.copyrightOwners>biopb</license.copyrightOwners>

    <!-- Fiji Latest bundles Java 21; the biopb SDK targets Java 11. -->
    <scijava.jvm.version>11</scijava.jvm.version>
    <scijava.jvm.build.version>[11,)</scijava.jvm.build.version>

    <!-- 0.13.0rc2 is the first release with TLS trust and the shared TOFU pin store
         (biopb#1401); catalogChildren (lazy catalog reads) is from 0.13.0rc1. -->
    <biopb.version>0.13.0rc2</biopb.version>

    <!-- Fiji's own versions of the jars it shares; see the provided block below. -->
    <fiji.netty.version>4.1.73.Final</fiji.netty.version>

    <!-- Arrow needs java.nio opened; Fiji's launcher provides this at runtime. -->
    <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
  </properties>

  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.github.jiyuuchc</groupId>
      <artifactId>biopb</artifactId>
      <version>${biopb.version}</version>
      <exclusions>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-buffer</artifactId></exclusion>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-codec</artifactId></exclusion>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-common</artifactId></exclusion>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-handler</artifactId></exclusion>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-resolver</artifactId></exclusion>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-transport</artifactId></exclusion>
        <exclusion><groupId>io.netty</groupId><artifactId>netty-tcnative-classes</artifactId></exclusion>
        <exclusion><groupId>io.grpc</groupId><artifactId>grpc-context</artifactId></exclusion>
        <exclusion><groupId>io.grpc</groupId><artifactId>grpc-netty</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!--
      Fiji shares these netty jars (4.1.73) and tcnative-classes (2.0.46) with other plugins. The
      SDK pulls newer ones, and "mvn install -Dscijava.app.directory" would replace Fiji's, so they
      are provided here: not copied into Fiji. TLS works on Fiji's versions (the jars Fiji lacks:
      netty-tcnative-boringssl-static, netty-codec-socks, handler-proxy, grpc-netty, arrow, ... are
      still installed).
    -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-buffer</artifactId>
      <version>${fiji.netty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec</artifactId>
      <version>${fiji.netty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-common</artifactId>
      <version>${fiji.netty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-handler</artifactId>
      <version>${fiji.netty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-resolver</artifactId>
      <version>${fiji.netty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
      <version>${fiji.netty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-tcnative-classes</artifactId>
      <version>2.0.46.Final</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty</artifactId>
      <version>1.70.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http</artifactId>
      <version>4.1.135.Final</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http2</artifactId>
      <version>4.1.135.Final</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <version>4.1.135.Final</version>
      <scope>provided</scope>
    </dependency>
    <!-- Not in Fiji: installed with the plugin. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-handler-proxy</artifactId>
      <version>4.1.110.Final</version>
      <scope>compile</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-socks</artifactId>
      <version>4.1.110.Final</version>
      <scope>compile</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>

    <!-- Provided by Fiji at runtime. -->
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>imagej</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.imglib2</groupId>
      <artifactId>imglib2</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
